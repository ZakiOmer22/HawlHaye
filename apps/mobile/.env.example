# Base URL the app sends API requests to (no trailing slash, no /api/v1).
# Use the API host directly (e.g. your Render URL) for best results; the Vercel
# domain also works because Next.js rewrites /api/v1/* to the API.
EXPO_PUBLIC_API_URL=https://hawl-haye.vercel.app

# MUST equal the API's WEB_ORIGIN env var exactly. The API's CSRF check only
# accepts requests whose Origin header matches it; native apps send no Origin
# on their own, so the app sets it explicitly.
EXPO_PUBLIC_WEB_ORIGIN=https://hawl-haye.vercel.app
