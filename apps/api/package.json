{
  "name": "@hawl/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:validate": "dotenv -e ../../.env -- prisma validate",
    "db:format": "dotenv -e ../../.env -- prisma format",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "audit:verify": "tsx scripts/verify-audit.ts",
    "sessions:cleanup": "tsx scripts/cleanup-sessions.ts"
  },
  "dependencies": {
    "@hawl/shared": "*",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/server": "^14.0.3",
    "argon2": "^0.45.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "file-type": "^18.7.0",
    "helmet": "^8.0.0",
    "multer": "^2.5.0",
    "otplib": "^12.0.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "xss": "^1.0.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1"
  }
}
