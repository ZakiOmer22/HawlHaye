# Copy to .env and fill in. NEVER commit .env. Names only here, no real secrets.
NODE_ENV=development

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://hawl:change-me@localhost:5432/hawl
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database container (infra/docker-compose.dev.yml)
POSTGRES_USER=hawl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hawl

# Production only
HAWL_DOMAIN=hawl.example.edu
BACKUP_PASSPHRASE_FILE=/run/secrets/backup_passphrase
BACKUP_REMOTE=offsite:hawl-backups
