{
  "name": "hawl",
  "version": "4.1.0",
  "private": true,
  "description": "HAWL - CECIT College Task Management System",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run build -w @hawl/shared && npm run dev -w @hawl/api",
    "dev:web": "npm run build -w @hawl/shared && npm run dev -w @hawl/web",
    "dev:studio": "npx prisma studio --schema=apps/api/prisma/schema.prisma",
    "build": "npm run build -w @hawl/shared && npm run build -w @hawl/api && npm run build -w @hawl/web",
    "typecheck": "npm run build -w @hawl/shared && npm run typecheck -w @hawl/api && npm run typecheck -w @hawl/web",
    "lint": "eslint .",
    "test": "npm run build -w @hawl/shared && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@next/eslint-plugin-next": "^16.4.6",
    "@types/node": "^20.16.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.2"
  },
  "dependencies": {
    "@hawl/web": "^3.1.0",
    "@sentry/node": "^11.10.0",
    "cors": "^2.8.6",
    "framer-motion": "^14.14.0"
  },
  "overrides": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.5",
    "effect": "^3.22.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "argon2@0.45.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "core-js@3.51.0": true,
    "@scarf/scarf@1.4.0": true
  }
}
